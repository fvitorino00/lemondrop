# lemondrop — environment template
#
# This file is a TEMPLATE and is safe to commit.
# Copy it to `.env` and adjust; `.env` is gitignored and must never be
# committed. No real secrets belong in this file — every value below is a
# placeholder or a non-sensitive default.
#
#   cp .env.example .env

# ── Networking ────────────────────────────────────────────────────────────────

# Host port published for the `api` service. This is the ONLY service with a
# host-published port; the other two stay on the internal compose network.
# Clients on this machine connect here.
API_HOST_PORT=8000

# Port the API listens on INSIDE the docker network. Other containers
# (embedder, reranker) reach the API here. It commonly matches
# API_HOST_PORT, but they are different things: one is the door on this
# machine, the other is the door inside docker.
API_INTERNAL_PORT=8000

# Internal container port for the `embedder` llama.cpp server. Reachable only
# from the other containers on the compose network.
EMBEDDER_INTERNAL_PORT=8080

# Internal container port for the `reranker` llama.cpp server. Reachable only
# from the other containers on the compose network.
# This is the same port as the embedder on purpose: each container has its own
# network namespace, so two containers can both listen on 8080 without
# conflict. What distinguishes them is the hostname (reranker vs embedder),
# which docker's internal DNS resolves. It must stay 8080 because the
# official llama.cpp image hardcodes its healthcheck to that port.
RERANKER_INTERNAL_PORT=8080

# ── Models ────────────────────────────────────────────────────────────────────

# Model alias the `embedder` loads at startup. bge-small-en-v1.5 — 384-dim
# embeddings, CLS pooling, runs on CPU at a useful speed.
EMBEDDER_MODEL_ALIAS=bge-small-en-v1.5

# Model alias the `reranker` loads at startup. bge-reranker-base — scores
# (query, passage) pairs, rank pooling.
RERANKER_MODEL_ALIAS=bge-reranker-base

# Dimensionality of the vectors the embedder produces. Must match the model
# above; used to size and validate the vector store index.
EMBEDDING_DIM=384

# ── Retrieval behaviour ──────────────────────────────────────────────────────

# Prefix prepended to every query string before embedding. bge retrieval
# models were trained with this instruction on the query side only; documents
# are embedded without it. Skipping it measurably degrades recall.
#
# THE LOAD-BEARING RULE: this string is prepended to the QUERY by POST /search
# and to NOTHING else, ever. `POST /embed` and `POST /documents` forward their
# text bare. A document stored with this prefix attached carries a permanently
# corrupted vector — its vector moves off the manifold the other documents live
# on, so it becomes much harder to match — and nothing in any response ever says
# that happened.
#
# The trailing space is part of the string. The query is `QUERY_PREFIX + text`,
# not `text` joined to this value by a separator.
QUERY_PREFIX="Represent this sentence for searching relevant passages: "

# Funnel size, stage 1: how many candidates the vector store returns before
# reranking.
#
# Why 10, and not the 50 this file used to document: 50 was never read by any
# code, so it was also never exercised. The reranker is a CROSS-ENCODER — it
# scores every (query, passage) pair it is handed, on CPU, with no batch
# discount and no GPU to hide behind — so 50 pairs is five times the inference
# work of 10 on the slowest thing this service does. And the host is already
# documented as tight: Milestone 2 measured this stack on a `t3.micro` with
# roughly 280Mi available at rest once both llama.cpp models are resident. A
# five-fold increase in the bottleneck is how a documented constraint becomes an
# incident.
#
# Raise it if the corpus or the hardware changes; 10 is a starting point sized
# against this host, not a claim about retrieval quality at any size.
RETRIEVAL_CANDIDATES=10

# Funnel size, stage 2: how many reranked results the API returns to the caller.
#
# MUST be <= RETRIEVAL_CANDIDATES. The reranker can only RE-ORDER the documents
# stage 1 returned, so it cannot produce more results than there were candidates.
# A top_k above the candidate count is not clamped at runtime and does not warn:
# the API refuses to start with a message naming both numbers, because otherwise
# it would serve a shorter result list than this file promises, on every query,
# with a 200 and nothing in the body saying so.
RERANK_TOP_K=5

# ── Development database (compose profile: devdb) ──────────────────────────────
# These drive the `postgres` service at the bottom of docker-compose.yml, which
# runs PostgreSQL 16 + pgvector for local development. It is gated behind the
# `devdb` profile, so the production boot on EC2 never starts it.
#
# Not used in production: production is RDS (PostgreSQL 16, per
# var.db_engine_version in infra/), not this container. Keep the two apart.

# Role the devdb image creates and connects as. The official postgres entrypoint
# creates this role and grants it ownership of the database below, on first
# boot of an empty volume.
DEV_DB_USER=lemondrop

# Password for the role above.
#
# THIS IS A PLACEHOLDER. Replace it with a real local value in your gitignored
# `.env` before starting the devdb. It is not a secret in the sense of being
# sensitive about anything — it protects a database holding test documents on a
# developer's own machine — but it is still a credential, and credentials
# committed to git are compromised credentials, permanently. The value below is
# literally "change-me", so anyone who forgets gets a loud, obvious failure
# rather than a silently weak password. Production has no equivalent entry here
# at all: the RDS master password comes from AWS Secrets Manager.
DEV_DB_PASSWORD=change-me

# Database the devdb image creates and serves. Note this is NOT a connection
# string — the port and host below are separate keys, because the port differs
# between the host side (published on loopback) and the container side.
DEV_DB_NAME=lemondrop

# Host port the devdb publishes for psql, bound to 127.0.0.1 ONLY. 5432 is the
# PostgreSQL default and is fine here; change it if something else on this
# machine already owns it. This is a loopback binding, not a published door —
# nothing off this host can reach it.
DEV_DB_HOST_PORT=5432

# Connection URL used ONLY by `alembic` (see api/alembic/README.md), for
# applying schema migrations. It is not a runtime application setting.
#
# It is a separate key from the devdb pieces above on purpose: migrations need
# broader privileges than the application does (they CREATE EXTENSION and own
# the schema), and pointing both at one variable is how a runtime role quietly
# acquires DDL rights it should never have had.
#
# NOTE: this file is the committed template, so the value below is a
# PLACEHOLDER and points at loopback. Locally, set this in your gitignored
# `.env` to match the devdb keys above:
#   ALEMBIC_DATABASE_URL=postgresql+asyncpg://lemondrop:<password>@127.0.0.1:5432/lemondrop
# The `+asyncpg` is required — Alembic drives the schema asynchronously and
# asyncpg is our only driver. Against RDS this points at the RDS endpoint
# instead, with credentials fetched from Secrets Manager at the moment the
# migration runs and never written into a file.
#
# Like DATABASE_URL below, this is a HOST-side value: 127.0.0.1 is where this
# machine's loopback published port is. See the note at the end of this file for
# why the `api` container composes a different DSN pointing at `postgres:5432`.
ALEMBIC_DATABASE_URL=postgresql+asyncpg://CHANGE_ME:CHANGE_ME@127.0.0.1:5432/CHANGE_ME

# ── Application database ─────────────────────────────────────────────────────
# The DSN the API itself connects with (api/app/config.py -> api/app/db.py).
# It is a SEPARATE key from ALEMBIC_DATABASE_URL above, and it must stay
# separate. Migrations CREATE EXTENSION and CREATE TABLE; the application only
# ever SELECTs. Sharing one variable is how a runtime role quietly acquires DDL
# rights it should never have had — the privilege is decided by which
# credentials the URL carries, not by which tool reads it, so a single `.env`
# edit that nobody can see at review time is enough to grant it.
#
# In production this is NOT a URL at all: it is fetched at runtime from SSM
# (`/lemondrop/dev/db/{host,port}` plus a secret ARN) and Secrets Manager, so
# the credential exists only in the process's memory. That substitution is
# implemented in `app/config.py` (`resolve_database_url_from_aws`, behind the
# `DatabaseUrlResolver` seam) and it runs whenever this variable is empty and
# DB_DSN_SOURCE below says `aws`. Which is the second half of why the api
# container's DATABASE_URL is set to an EMPTY string on a production host — see
# DEV_DATABASE_URL at the end of this file.
#
# As with the migration URL above, this file is the committed template so the
# value is a PLACEHOLDER. Locally, set it in your gitignored `.env` to match
# the DEV_DB_* keys:
#   DATABASE_URL=postgresql+asyncpg://lemondrop:<password>@127.0.0.1:5432/lemondrop
#
# There is deliberately NO default. If this is unset the API logs that the
# database is unconfigured, still serves, and answers 503 on /health/ready —
# it does not start up pointing at a database nobody chose.
#
# ── WHY THE HOST IS 127.0.0.1 HERE AND postgres IN THE CONTAINER ─────────────
# Both keys above point at 127.0.0.1:5432, and that is correct: they are read by
# processes running ON this workstation — `alembic upgrade head`, and pytest
# importing app.db directly. 127.0.0.1 is this machine's loopback, which is where
# the devdb publishes its port (DEV_DB_HOST_PORT).
#
# The `api` CONTAINER does not read this file. Compose reads `.env` to interpolate
# the `${...}` inside docker-compose.yml, and it does not copy those variables into
# containers on its own — which is why the `api` service has an explicit
# `environment:` block. That block passes through DEV_DATABASE_URL (the last key in
# this file) rather than composing anything of its own, so the container's DSN is
# a key you supply here, written against the `postgres` service name:
#
#   DEV_DATABASE_URL=postgresql+asyncpg://lemondrop:<password>@postgres:5432/lemondrop
#
# Two different targets, both right, and the difference is the network namespace:
# inside a container, 127.0.0.1 is that container's own loopback, where nothing
# listens on 5432. `postgres` is the compose SERVICE NAME, resolved by Docker's
# embedded DNS on the compose network. Copying this file's host-side DSN into the
# container verbatim produces `connection refused` inside `api` while `psql` on the
# workstation connects perfectly — so the container DSN is a separate key with a
# different host in it, and is never inherited from this one.
#
# Because it lands on the container as a plain environment entry, `docker inspect`
# on the api container prints the resolved password to anyone who can read the
# docker socket. That is acceptable for this throwaway local database and would be
# unacceptable for a real secret. Production is RDS with credentials fetched from
# Secrets Manager at runtime, so it uses none of these values — see DEV_DATABASE_URL
# below for why production's copy of this file is empty there.
#
# To exercise the container path, start the profile-gated devdb explicitly, then
# rebuild the api; `api` has no `depends_on` on it, by design, because that
# service does not exist on the EC2 production host:
#     docker compose --profile devdb up -d postgres
#     docker compose up -d --build api
DATABASE_URL=postgresql+asyncpg://CHANGE_ME:CHANGE_ME@127.0.0.1:5432/CHANGE_ME

# ── Container DSN and DSN source (read by docker-compose.yml) ─────────────────
# DEV_DATABASE_URL is the DSN the `api` CONTAINER receives, and it is a
# LOCAL-DEVELOPMENT-ONLY override: the host-side DATABASE_URL above is for
# processes on this machine (alembic, pytest), this one is for the container, and
# the two differ only in the host they name. Nothing in production reads a DSN
# from a file.
#
# DELIBERATELY EMPTY IN THIS TEMPLATE. The container path only works once you
# have filled it in, and that is the correct amount of ceremony: this file is
# committed, so shipping a DSN that actually works here would mean shipping a
# credential with a known username, host and port to every clone of the repo. Copy
# this file to `.env` and set DEV_DATABASE_URL to the shape below, using the
# DEV_DB_USER / DEV_DB_PASSWORD / DEV_DB_NAME values you chose above:
#
#   DEV_DATABASE_URL=postgresql+asyncpg://<user>:<password>@postgres:5432/<database>
#
# The host is `postgres`, the compose service name — NOT 127.0.0.1, which inside a
# container is that container's own loopback where nothing listens. See the note
# above.
#
# Leaving it EMPTY in a copied `.env` is not a broken setup, it is the production
# shape: the api service declares `DATABASE_URL: "${DEV_DATABASE_URL:-}"`, so an
# unset or empty value gives the container an EMPTY DATABASE_URL. api/app/config.py
# returns DATABASE_URL unchanged whenever it is set and non-blank, so an empty one
# is what lets the resolver fall through to AWS instead of handing it a
# local-looking DSN it was never meant to use.
DEV_DATABASE_URL=

# Which source api/app/config.py reads the DSN from. Exactly two values are legal:
#
#   environment  read DATABASE_URL from the process environment. THE DEFAULT, and
#                the local choice: you filled in DEV_DATABASE_URL above, so this
#                is the source that serves it.
#   aws          resolve host and port from SSM and the credential from Secrets
#                Manager, through the EC2 instance role. This is what the EC2 host
#                sets in its own /opt/lemondrop/.env AFTER BOOT — scripts/boot.sh
#                copies THIS FILE over .env there, so a fresh production host
#                starts on `environment` and must be flipped by hand.
#
# There is deliberately NO autodetect. Inferring the source would mean a host that
# forgot this variable silently reading whatever DATABASE_URL it happened to be
# handed — aimed, in the failure case, at production RDS from a laptop, or at the
# devdb from EC2. An unset variable that means one unambiguous thing ("environment")
# and an unknown one that is a hard error both fail loudly; autodetection fails
# quietly, in the one direction that matters.
DB_DSN_SOURCE=environment
